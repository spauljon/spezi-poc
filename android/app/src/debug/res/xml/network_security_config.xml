<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: trust the local POC CA (public certificate only, copied at build time from ~/.poc-ca/ca.crt). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <debug-overrides>
        <trust-anchors>
            <certificates src="@raw/poc_ca" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
