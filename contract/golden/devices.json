{
  "contractVersion": "1.0.0",
  "cases": [
    {
      "name": "device-synthetic",
      "note": "The synthetic simulator has a fixed key and fixed descriptive fields.",
      "patientId": "example-patient",
      "descriptor": {
        "kind": "synthetic"
      },
      "expected": {
        "resourceType": "Device",
        "identifier": [
          {
            "system": "http://blueysoft.com/fhir/identifier/device-key",
            "value": "synthetic-simulator"
          }
        ],
        "status": "active",
        "manufacturer": "Spezi POC",
        "deviceName": [
          {
            "name": "Synthetic simulator",
            "type": "model-name"
          }
        ],
        "patient": {
          "reference": "Patient/example-patient"
        }
      }
    },
