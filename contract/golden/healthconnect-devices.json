    {
      "name": "hc-device-full",
      "note": "A record with a device: keyed by manufacturer, model and the type name.",
      "patientId": "example-patient",
      "origin": "com.example.wearable",
      "device": {
        "manufacturer": "Example Corp",
        "model": "Band 2",
        "type": 6
      },
      "expectedKey": "e5fb007404734e90369ba77a41457f4a8f71376f1a95e987c628f2f06d1a0cdd",
      "expected": {
        "resourceType": "Device",
        "identifier": [
          {
            "system": "http://aboutobjects.com/fhir/identifier/device-key",
