// Non-secret defaults for the capture app. Overridden by Config/Local.xcconfig (git-ignored) if present.
//
// Nothing here is a credential: the app is a PUBLIC OAuth client (authorization code + PKCE), and the user's
// password is only ever typed into Keycloak's own login page.
//
// "https:/$()/" is the usual xcconfig trick: a bare "//" would start a comment.

POC_HOST = macpro16.local
POC_FHIR_BASE_URL = https:/$()/$(POC_HOST):8443/fhir
POC_ISSUER_URL = https:/$()/$(POC_HOST):8444/realms/poc
POC_CLIENT_ID = ios-capture
POC_REDIRECT_SCHEME = com.blueysoft.spezipoc

// Optional per-developer overrides (same keys as above); the file is not committed.
#include? "Local.xcconfig"
